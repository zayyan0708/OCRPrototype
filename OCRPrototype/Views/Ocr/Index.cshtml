@model OCRPrototype.Models.OcrUploadViewModel
@{
    ViewData["Title"] = "Egyptian ID OCR";
}

<div class="container py-4" style="max-width: 640px;">
    <h1 class="h3 mb-3">Egyptian ID Card OCR</h1>
    <p class="text-muted">Upload a photo of the front of the card. Works best with good lighting and the card filling most of the frame.</p>

    <form asp-action="Index" method="post" enctype="multipart/form-data" class="mb-4">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <input type="file" name="IdImage" id="IdImage" class="form-control" accept="image/*" required
                   onchange="previewImage(this)" />
            <span asp-validation-for="IdImage" class="text-danger"></span>
        </div>

        <img id="preview" class="img-fluid rounded border mb-3 d-none" alt="Selected ID preview" />

        <button type="submit" class="btn btn-primary">Extract text</button>
    </form>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    @if (Model.Result is not null)
    {
        <h2 class="h5">Result</h2>

        @if (Model.Result.IdInformations.Count == 0)
        {
            <p class="text-muted">No text was detected - try a sharper photo.</p>
        }
        else
        {
            <ul class="list-group mb-3">
                @foreach (string line in Model.Result.IdInformations)
                {
                    <li class="list-group-item" dir="auto">@line</li>
                }
            </ul>
        }

        <pre class="bg-light border rounded p-3" style="direction: ltr;">@System.Text.Json.JsonSerializer.Serialize(
            Model.Result,
            new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            })</pre>
    }
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            const preview = document.getElementById('preview');
            if (input.files && input.files[0]) {
                preview.src = URL.createObjectURL(input.files[0]);
                preview.classList.remove('d-none');
            }
        }
    </script>
}
