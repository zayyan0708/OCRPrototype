@model OCRPrototype.Models.OcrUploadViewModel
@{
    ViewData["Title"] = "Egyptian ID OCR";
}

<div class="container py-4" style="max-width: 640px;">
    <h1 class="h3 mb-3">Egyptian ID Card OCR</h1>
    <p class="text-muted">Upload a photo of the front of the card. Works best with good lighting and the card filling most of the frame.</p>

    <form asp-action="Index" method="post" enctype="multipart/form-data" class="mb-4">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <input type="file" name="IdImage" id="IdImage" class="form-control" accept="image/*" required
                   onchange="previewImage(this)" />
            <span asp-validation-for="IdImage" class="text-danger"></span>
        </div>

        <img id="preview" class="img-fluid rounded border mb-3 d-none" alt="Selected ID preview" />

        <button type="submit" class="btn btn-primary">Extract text</button>
    </form>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

@if (Model.Result is not null)
{
        <hr />

        <h2 class="h5">OCR Result</h2>

    @if (!Model.Result.IsSuccess)
    {
            <div class="alert alert-danger">
                @Model.Result.ErrorMessage
            </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.Result.Photo))
        {
                <img src="data:image/jpeg;base64,@Model.Result.Photo"
                     style="max-width: 180px;"
                     class="img-thumbnail mb-3"
                     alt="ID photo" />
        }

            <table class="table table-bordered">
                <tr>
                    <th>First name</th>
                    <td dir="rtl">@Model.Result.FirstName</td>
                </tr>

                <tr>
                    <th>Full name</th>
                    <td dir="rtl">@Model.Result.FullName</td>
                </tr>

                <tr>
                    <th>Address</th>
                    <td dir="rtl">@Model.Result.Address</td>
                </tr>

                <tr>
                    <th>National ID</th>
                    <td>@Model.Result.NationalId</td>
                </tr>

                <tr>
                    <th>Card ID</th>
                    <td>@Model.Result.CardId</td>
                </tr>

                <tr>
                    <th>Date of birth</th>
                    <td>@Model.Result.DateOfBirth</td>
                </tr>
            </table>

        @if (!string.IsNullOrWhiteSpace(Model.Result.Warning))
        {
                <div class="alert alert-warning">
                    @Model.Result.Warning
                </div>
        }

            <pre>@System.Text.Json.JsonSerializer.Serialize(
                                Model.Result,
                                new System.Text.Json.JsonSerializerOptions
                                {
                                        WriteIndented = true,
                                        Encoder =
                                                System.Text.Encodings.Web.JavaScriptEncoder
                                                        .UnsafeRelaxedJsonEscaping
                                })</pre>
    }
}

@section Scripts {
    <script>
        function previewImage(input) {
            const preview = document.getElementById('preview');
            if (input.files && input.files[0]) {
                preview.src = URL.createObjectURL(input.files[0]);
                preview.classList.remove('d-none');
            }
        }
    </script>
}
