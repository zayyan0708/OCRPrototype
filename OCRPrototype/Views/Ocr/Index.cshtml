@model OCRPrototype.Models.OcrUploadViewModel

@{
    ViewData["Title"] = "Egyptian ID OCR";
}

<div class="container py-4"
     style="max-width: 760px;">

    <h1 class="h3 mb-3">
        Egyptian ID Card OCR
    </h1>

    <p class="text-muted">
        Upload a clear photo of the front of the card.
        Keep the full card visible and approximately horizontal.
    </p>

    <form asp-action="Index"
          method="post"
          enctype="multipart/form-data"
          class="mb-4">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <input type="file"
                   name="IdImage"
                   id="IdImage"
                   class="form-control"
                   accept="image/*"
                   required
                   onchange="previewImage(this)" />

            <span asp-validation-for="IdImage"
                  class="text-danger"></span>
        </div>

        <img id="preview"
             class="img-fluid rounded border mb-3 d-none"
             alt="Selected ID preview" />

        <button type="submit"
                class="btn btn-primary">
            Extract ID information
        </button>
    </form>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    @if (Model.Result is not null)
    {
        <h2 class="h5 mb-3">
            Personal Information
        </h2>

        @if (!Model.Result.HasAnyValue)
        {
            <div class="alert alert-warning">
                No personal information could be extracted.
                Try a sharper and better-lit image.
            </div>
        }
        else
        {
            <table class="table table-bordered align-middle">
                <tbody>

                    <tr>
                        <th style="width: 180px;">
                            First Name
                        </th>
                        <td dir="auto">
                            @(Model.Result.FirstName ?? "Not detected")
                        </td>
                    </tr>

                    <tr>
                        <th>
                            Rest of Name
                        </th>
                        <td dir="auto">
                            @(Model.Result.RestOfName ?? "Not detected")
                        </td>
                    </tr>

                    <tr>
                        <th>
                            Address Line 1
                        </th>
                        <td dir="auto">
                            @(Model.Result.AddressLine1 ?? "Not detected")
                        </td>
                    </tr>

                    <tr>
                        <th>
                            Address Line 2
                        </th>
                        <td dir="auto">
                            @(Model.Result.AddressLine2 ?? "Not detected")
                        </td>
                    </tr>

                    <tr>
                        <th>
                            National ID
                        </th>
                        <td dir="ltr">
                            @(Model.Result.NationalId ?? "Not detected")
                        </td>
                    </tr>

                    <tr>
                        <th>
                            Card Number
                        </th>
                        <td dir="ltr">
                            @(Model.Result.CardNumber ?? "Not detected")
                        </td>
                    </tr>

                </tbody>
            </table>
        }

        <h2 class="h5 mt-4">
            JSON
        </h2>

        <pre class="bg-light border rounded p-3"
             style="direction: ltr;">@System.Text.Json.JsonSerializer.Serialize(
                                      Model.Result,
                                      new System.Text.Json.JsonSerializerOptions
                                      {
                                              WriteIndented = true,
                                              Encoder =
                                                      System.Text.Encodings.Web
                                                              .JavaScriptEncoder
                                                              .UnsafeRelaxedJsonEscaping
                                      })</pre>
        }
</div>

@section Scripts
{
    <script>
        function previewImage(input) {
            const preview =
                document.getElementById('preview');

            if (input.files &&
                input.files[0]) {

                preview.src =
                    URL.createObjectURL(
                        input.files[0]);

                preview.classList.remove(
                    'd-none');
            }
        }
    </script>
}